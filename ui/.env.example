# Copy to .env and fill in from your own app registration.
# Neither value is a secret: a SPA is a public client and both ids are visible
# in the browser. The registration must be a Single-page application whose
# redirect URI is exactly http://localhost:5173, with requestedAccessTokenVersion 2.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
